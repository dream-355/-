# Server settings
NEO4J_PASSWORD=replace-with-a-strong-database-password
NEO4J_HEAP_INITIAL=768m
NEO4J_HEAP_MAX=1g
NEO4J_PAGECACHE=512m
APP_SECRET=replace-with-at-least-32-random-characters
DEEPSEEK_API_KEY=

# Application settings
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_VISION_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=45
APP_NAME=知衡健康
SESSION_DAYS=14
DEMO_MODE=true
COOKIE_SECURE=false
AUTH_RATE_LIMIT_PER_MINUTE=10
REVIEW_LLM_ENABLED=true
PUBLIC_BASE_URL=http://replace-with-server-public-ip

# Email/SMTP is intentionally disabled for this deployment.
