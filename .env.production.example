# Required server settings
DOMAIN=zhihengcare.icu
NEO4J_PASSWORD=replace-with-a-strong-database-password
NEO4J_HEAP_INITIAL=768m
NEO4J_HEAP_MAX=1g
NEO4J_PAGECACHE=512m
APP_SECRET=replace-with-at-least-32-random-characters
DEEPSEEK_API_KEY=replace-with-your-deepseek-key

# Application settings
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_VISION_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=45

# SMTP email (registration notice, reset code, health reports)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=no-reply@example.com
SMTP_PASSWORD=replace-with-smtp-authorization-code
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=知衡健康
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT=15
PUBLIC_BASE_URL=https://zhihengcare.icu

APP_NAME=知衡健康
SESSION_DAYS=14
DEMO_MODE=true
COOKIE_SECURE=true
AUTH_RATE_LIMIT_PER_MINUTE=10
REVIEW_LLM_ENABLED=true

