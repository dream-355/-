# Neo4j（本机现有容器默认映射到 7689）
NEO4J_URI=bolt://localhost:7689
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me
NEO4J_DATABASE=neo4j

# DeepSeek OpenAI-compatible API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_VISION_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=45

# SMTP email (registration notice, reset code, health reports)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=知衡健康
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT=15
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Application
APP_NAME=知衡健康
APP_SECRET=replace-with-a-long-random-string
SESSION_DAYS=14
DEMO_MODE=true
COOKIE_SECURE=false
AUTH_RATE_LIMIT_PER_MINUTE=10
REVIEW_LLM_ENABLED=true

